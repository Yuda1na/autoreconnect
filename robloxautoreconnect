task.wait(3)
repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local GuiService = game:GetService("GuiService")
local TeleportService = game:GetService("TeleportService")

local RETRY_GAP = 2
local SAME_SERVER_FIRST = true
local SHOW_BTN = true

local placeId = game.PlaceId
local jobId = game.JobId

local on = true
local disconnected = false
local lastTry = 0
local firing = false

local function log(...)
    print("reconnect:", ...)
end

local function sameServer()
    if not SAME_SERVER_FIRST or jobId == "" then return false end
    local ok = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, jobId, Players.LocalPlayer)
    end)
    if ok then log("tried same server") end
    return ok
end

local function anyServer()
    local ok = pcall(function()
        TeleportService:Teleport(placeId, Players.LocalPlayer)
    end)
    if ok then log("tried any server") end
    return ok
end

local function deepLink()
    local link
    if SAME_SERVER_FIRST and jobId ~= "" then
        link = ("roblox://placeId=%d&gameInstanceId=%s"):format(placeId, jobId)
    else
        link = ("roblox://placeId=%d"):format(placeId)
    end
    local ok = pcall(function()
        GuiService:OpenBrowserWindow(link)
    end)
    if ok then log("tried deep link") end
    return ok
end

local function fire()
    if not on then return end
    if os.clock() - lastTry < RETRY_GAP then return end
    lastTry = os.clock()

    log("firing")

    if not sameServer() then
        if not anyServer() then
            deepLink()
        end
    end
end
task.spawn(function()
    while true do
        task.wait(1)
        if on and disconnected then
            fire()
        end
    end
end)

GuiService.ErrorMessageChanged:Connect(function(msg)
    if not on then return end
    if msg and msg ~= "" then
        log("message:", msg)
        disconnected = true
        fire()
    end
end)

task.spawn(function()
    repeat task.wait() until CoreGui:FindFirstChild("RobloxPromptGui")
    local overlay = CoreGui.RobloxPromptGui:WaitForChild("promptOverlay")

    overlay.ChildAdded:Connect(function(child)
        if not on then return end
        if child.Name == "ErrorPrompt" then
            log("prompt appeared")
            disconnected = true
            fire()
        end
    end)
    overlay.ChildRemoved:Connect(function(child)
        if child.Name == "ErrorPrompt" then
            log("prompt cleared")
            disconnected = false
        end
    end)
end)

if SHOW_BTN then
    local old = CoreGui:FindFirstChild("rc_tool")
    if old then old:Destroy() end

    local screen = Instance.new("ScreenGui")
    screen.Name = "rc_tool"
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.Parent = CoreGui

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(200, 30)
    btn.Position = UDim2.fromOffset(20, 20)
    btn.BackgroundColor3 = Color3.fromRGB(36, 36, 38)
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.TextColor3 = Color3.fromRGB(230, 226, 210)
    btn.Text = "reconnect: on"
    btn.Parent = screen

    local uc = Instance.new("UICorner")
    uc.CornerRadius = UDim.new(0, 6)
    uc.Parent = btn

    local us = Instance.new("UIStroke")
    us.Color = Color3.fromRGB(200, 170, 60)
    us.Thickness = 1
    us.Parent = btn

    local function redraw()
        if on then
            btn.Text = "reconnect: on"
            btn.TextColor3 = Color3.fromRGB(230, 226, 210)
            us.Color = Color3.fromRGB(200, 170, 60)
        else
            btn.Text = "reconnect: off"
            btn.TextColor3 = Color3.fromRGB(140, 140, 140)
            us.Color = Color3.fromRGB(80, 80, 80)
        end
    end

    btn.Activated:Connect(function()
        on = not on
        redraw()
        if on and disconnected then fire() end
    end)

    redraw()

    do
        local drag, start, base
        btn.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                drag = true
                start = i.Position
                base = btn.Position
            end
        end)
        btn.InputChanged:Connect(function(i)
            if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
                or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - start
                btn.Position = UDim2.new(base.X.Scale, base.X.Offset + d.X,
                                         base.Y.Scale, base.Y.Offset + d.Y)
            end
        end)
        game:GetService("UserInputService").InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                drag = false
            end
        end)
    end
end

log("watching", placeId, jobId)
